<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 지도 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map_fragment"
        android:name="com.naver.maps.map.MapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- ===== 상단 검색 + 필터 탭 영역 ===== -->

    <!-- 검색창 + 설정 아이콘 (가로 배치) -->
    <LinearLayout
        android:id="@+id/top_search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp">

        <!-- 검색 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/main_search_card"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:id="@+id/main_search_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="어디로 갈까요?"
                    android:textSize="15sp"
                    android:textColor="#888888"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 설정 버튼 (오른쪽) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_fake_call_setting"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_setting"
                app:tint="#444444"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- [경로탐색] 입력 패널 (처음엔 숨김) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/route_input_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 출발지 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="12dp">
                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"/>
                <EditText
                    android:id="@+id/start_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="출발지"
                    android:background="@null"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

            <!-- 목적지 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="12dp">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:layout_marginEnd="12dp"/>
                <EditText
                    android:id="@+id/goal_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="목적지"
                    android:background="@null"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== 필터 탭 (CCTV / 보안등 / 인프라) - 검색창 아래 ===== -->
    <!-- layout_below는 코드에서 동적으로 top_search_row <-> route_input_card 사이 전환됨 -->
    <HorizontalScrollView
        android:id="@+id/filter_tab_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_search_row"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- CCTV 탭 -->
            <LinearLayout
                android:id="@+id/tab_cctv"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_tab_default"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/tab_cctv_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_nav_cctv"
                    android:layout_marginEnd="5dp"
                    app:tint="#666666"/>
                <TextView
                    android:id="@+id/tab_cctv_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CCTV"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 보안등 탭 -->
            <LinearLayout
                android:id="@+id/tab_streetlight"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_tab_default"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/tab_streetlight_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_nav_light"
                    android:layout_marginEnd="5dp"
                    app:tint="#666666"/>
                <TextView
                    android:id="@+id/tab_streetlight_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="보안등"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 인프라 탭 (편의점/소방서/경찰서) -->
            <LinearLayout
                android:id="@+id/tab_infra"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_filter_tab_default"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/tab_infra_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_nav_layers"
                    android:layout_marginEnd="5dp"
                    app:tint="#666666"/>
                <TextView
                    android:id="@+id/tab_infra_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인프라"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== 오른쪽 버튼 그룹: 비상벨 / 가짜전화 / 사진촬영 ===== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/overlay_buttons_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 비상벨 -->
            <LinearLayout
                android:id="@+id/btn_sos_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="11dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/sos_btn"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_nav_light"
                    app:tint="#444444"/>
                <TextView
                    android:id="@+id/sos_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비상벨"
                    android:textSize="11sp"
                    android:textColor="#444444"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <View android:layout_width="42dp" android:layout_height="1dp"
                android:layout_gravity="center" android:background="#EEEEEE"/>

            <!-- 가짜전화 -->
            <LinearLayout
                android:id="@+id/call_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="11dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_nav_call"
                    app:tint="#444444"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="가짜전화"
                    android:textSize="11sp"
                    android:textColor="#444444"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <View android:layout_width="42dp" android:layout_height="1dp"
                android:layout_gravity="center" android:background="#EEEEEE"/>

            <!-- 사진촬영 (버튼 UI만, 실제 기능은 추후 구현) -->
            <LinearLayout
                android:id="@+id/btn_photo_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="11dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/photo_btn"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#444444"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사진촬영"
                    android:textSize="11sp"
                    android:textColor="#444444"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 자동완성 목록 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/suggestion_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/route_input_card"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp">
        <ListView
            android:id="@+id/suggestion_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="#EEEEEE"
            android:dividerHeight="1dp"/>
    </androidx.cardview.widget.CardView>

    <!-- 하단 경로 결과 카드 3개 -->
    <HorizontalScrollView
        android:id="@+id/route_result_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btn_start_navi"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="8dp"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- 경로 카드 1 (추천 - 안전) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/route_card_1"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#3D6BF5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView android:id="@+id/label_1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="추천 1" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:id="@+id/time_1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--분" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/dist_1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--km · --걸음" android:textColor="#CCDDFF" android:textSize="12sp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#5577FF" android:layout_marginVertical="6dp"/>
                    <TextView android:id="@+id/cctv_1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CCTV --개" android:textColor="#CCDDFF" android:textSize="12sp"/>
                    <TextView android:id="@+id/light_1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="보안등 --개" android:textColor="#CCDDFF" android:textSize="12sp"/>
                    <TextView android:id="@+id/score_1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="안전점수 --점" android:textColor="#FFFFFF"
                        android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 경로 카드 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/route_card_2"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView android:id="@+id/label_2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="추천 2" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:id="@+id/time_2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--분" android:textSize="26sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/dist_2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--km · --걸음" android:textSize="12sp" android:textColor="#888888"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#EEEEEE" android:layout_marginVertical="6dp"/>
                    <TextView android:id="@+id/cctv_2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CCTV --개" android:textSize="12sp" android:textColor="#888888"/>
                    <TextView android:id="@+id/light_2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="보안등 --개" android:textSize="12sp" android:textColor="#888888"/>
                    <TextView android:id="@+id/score_2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="안전점수 --점" android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 경로 카드 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/route_card_3"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView android:id="@+id/label_3"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="추천 3" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:id="@+id/time_3"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--분" android:textSize="26sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/dist_3"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--km · --걸음" android:textSize="12sp" android:textColor="#888888"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#EEEEEE" android:layout_marginVertical="6dp"/>
                    <TextView android:id="@+id/cctv_3"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CCTV --개" android:textSize="12sp" android:textColor="#888888"/>
                    <TextView android:id="@+id/light_3"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="보안등 --개" android:textSize="12sp" android:textColor="#888888"/>
                    <TextView android:id="@+id/score_3"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="안전점수 --점" android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btn_start_navi"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:text="이 경로로 안심 귀가"
        android:backgroundTint="#3D6BF5"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="16sp"/>

</RelativeLayout>