<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 지도 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navi_map_fragment"
        android:name="com.naver.maps.map.MapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 상단 방향 안내 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/direction_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#3D6BF5">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">
            <ImageButton
                android:id="@+id/btn_close_navi"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@null"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:id="@+id/tv_direction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="경로 안내 시작"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== 오른쪽 버튼 카드: 비상벨 / 가짜전화 / 사진촬영 ===== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/navi_overlay_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/direction_card"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 비상벨 (SOS) -->
            <LinearLayout
                android:id="@+id/sos_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="11dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@null">
                <ImageView
                    android:id="@+id/sos_icon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_nav_light"
                    app:tint="#444444"/>
                <TextView
                    android:id="@+id/sos_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비상벨"
                    android:textSize="11sp"
                    android:textColor="#444444"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <View android:layout_width="42dp" android:layout_height="1dp"
                android:layout_gravity="center" android:background="#EEEEEE"/>

            <!-- 가짜전화 -->
            <LinearLayout
                android:id="@+id/call_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="11dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@null">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_nav_call"
                    app:tint="#444444"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="가짜전화"
                    android:textSize="11sp"
                    android:textColor="#444444"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <View android:layout_width="42dp" android:layout_height="1dp"
                android:layout_gravity="center" android:background="#EEEEEE"/>

            <!-- 사진촬영 -->
            <LinearLayout
                android:id="@+id/btn_photo_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="11dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@null">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#444444"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사진촬영"
                    android:textSize="11sp"
                    android:textColor="#444444"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== 하단 정보 카드 (시간/거리/걸음) ===== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottom_info_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_remaining_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--분"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#3D6BF5"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="남은 시간"
                    android:textSize="12sp"
                    android:textColor="#888888"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="40dp" android:background="#EEEEEE"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_remaining_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--km"
                    android:textSize="28sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="남은 거리"
                    android:textSize="12sp"
                    android:textColor="#888888"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="40dp" android:background="#EEEEEE"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_remaining_steps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--걸음"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="남은 걸음"
                    android:textSize="12sp"
                    android:textColor="#888888"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- CCTV 사각지대 경고 카드 (하단 정보 카드 바로 위) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/blind_spot_warning_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_info_card"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@android:color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:id="@+id/iv_blind_spot_icon"
                android:src="@android:drawable/ic_dialog_alert"
                android:layout_marginEnd="12dp"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CCTV 사각지대 진입"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FF6600"/>
                <TextView
                    android:id="@+id/tv_blind_spot_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150m 이전까지 CCTV가 없습니다!"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== 필터 탭 (CCTV / 보안등 / 인프라) ===== -->
    <HorizontalScrollView
        android:id="@+id/navi_filter_tab_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/direction_card"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- CCTV 탭 -->
            <LinearLayout
                android:id="@+id/navi_tab_cctv"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_tab_default"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/navi_tab_cctv_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_nav_cctv"
                    android:layout_marginEnd="5dp"
                    app:tint="#666666"/>
                <TextView
                    android:id="@+id/navi_tab_cctv_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CCTV"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 보안등 탭 -->
            <LinearLayout
                android:id="@+id/navi_tab_streetlight"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_tab_default"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/navi_tab_streetlight_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_nav_light"
                    android:layout_marginEnd="5dp"
                    app:tint="#666666"/>
                <TextView
                    android:id="@+id/navi_tab_streetlight_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="보안등"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 인프라 탭 -->
            <LinearLayout
                android:id="@+id/navi_tab_infra"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_filter_tab_default"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/navi_tab_infra_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_nav_layers"
                    android:layout_marginEnd="5dp"
                    app:tint="#666666"/>
                <TextView
                    android:id="@+id/navi_tab_infra_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인프라"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

</RelativeLayout>